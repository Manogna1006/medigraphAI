# --- Neo4j (Knowledge Graph) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme

# --- Groq (LLM inference - Llama 3.1) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# --- ChromaDB (vector store) ---
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=medigraph_corpus

# --- Semantic Firewall thresholds ---
VECTOR_DISTANCE_THRESHOLD=0.35
MIN_KG_TRIPLETS_REQUIRED=1

# --- Hallucination evaluation ---
HALLUCINATION_JUDGE_MODEL=llama-3.1-70b-versatile
HALLUCINATION_RATE_ALERT_THRESHOLD=0.15

# --- OpenAlex ingestion ---
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_MAILTO=you@example.com
OPENALEX_MIN_AUTHORITY_SCORE=0.3
OPENALEX_MAX_WORKS_PER_TOPIC=50

# --- App ---
LOG_LEVEL=INFO
APP_ENV=development
